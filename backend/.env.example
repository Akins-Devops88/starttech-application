# Application
PORT=8080
DB_NAME=much_todo_db

# MongoDB Docker Compose example
MONGO_USER=example_user
MONGO_PASSWORD=replace_with_a_strong_password
MONGO_URI=mongodb://example_user:replace_with_a_strong_password@mongodb:27017/much_todo_db?authSource=admin

# Authentication - replace with a securely generated secret
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRATION_HOURS=72

# Redis - optional for local development
ENABLE_CACHE=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
