# StartTech MuchTodo Application
# Example environment configuration
# Never commit actual credentials or secrets to GitHub.

# Application
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# MongoDB Atlas
MONGO_URI=mongodb+srv://YOUR_ATLAS_USERNAME:YOUR_ATLAS_PASSWORD@YOUR_CLUSTER.mongodb.net/much_todo_db?retryWrites=true&w=majority
DB_NAME=much_todo_db

# JWT Authentication
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRATION_HOURS=72

# Redis ElastiCache
ENABLE_CACHE=true
REDIS_ADDR=YOUR_ELASTICACHE_ENDPOINT:6379
REDIS_PASSWORD=
REDIS_TLS=true
